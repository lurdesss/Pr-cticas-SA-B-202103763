# Copiar como .env y completar. NUNCA subir .env al repositorio.

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/auth_db

# --- Firma del JWT (mínimo 32 caracteres) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar_por_un_valor_aleatorio_de_al_menos_32_caracteres
JWT_ALGORITMO=HS256

# --- Requisito 4: vida del token, en segundos ---
JWT_TTL_SEGUNDOS=180

# --- Requisito 5: ventana de gracia para renovación, en segundos ---
# Un token expirado hace menos de este tiempo se renueva solo.
JWT_GRACIA_RENOVACION_SEGUNDOS=60

# --- Requisito 6: cifrado AES de datos sensibles (mínimo 32 caracteres) ---
AES_CLAVE=cambiar_por_otro_valor_aleatorio_de_32_o_mas
INDICE_CIEGO_CLAVE=cambiar_por_un_tercer_valor_aleatorio_distinto

# --- Requisito 9: cliente del microservicio de autorización ---
AUTHZ_URL=http://127.0.0.1:8001
AUTHZ_MAX_REINTENTOS=4
AUTHZ_BACKOFF_INICIAL_MS=200
AUTHZ_BACKOFF_FACTOR=2.0
AUTHZ_TIMEOUT_MS=1500

# --- Cookie de sesión ---
COOKIE_NOMBRE=acceso_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Aplicación ---
APP_NAME=Servicio de Autenticación
APP_VERSION=1.0.0
DEBUG=false
ORIGENES_PERMITIDOS=http://127.0.0.1:5500,http://localhost:5500

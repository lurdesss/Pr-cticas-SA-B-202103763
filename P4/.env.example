# ------------------------------------------------------------------
# Copia este archivo a .env y completa los tres secretos.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux / macOS)
#
# Genera cada secreto por separado (ejecuta el comando TRES veces):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------

# Base de datos (se crea dentro del contenedor, no necesitas Neon)
POSTGRES_USER=aroma
POSTGRES_PASSWORD=aroma

# Secretos del servicio de autenticacion (heredados de la Practica 2).
# Deben ser DISTINTOS entre si y de al menos 32 caracteres.
JWT_SECRETO=cambia-esto-por-un-secreto-largo-generado-con-secrets
AES_CLAVE=cambia-esto-por-otro-secreto-largo-distinto-del-anterior
INDICE_CIEGO_CLAVE=cambia-esto-por-un-tercer-secreto-largo-distinto

# Ciclo de vida del token
JWT_TTL_SEGUNDOS=180
JWT_GRACIA_RENOVACION_SEGUNDOS=60

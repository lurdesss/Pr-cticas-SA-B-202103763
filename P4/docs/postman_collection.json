              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "201 y cookie HttpOnly. Si el correo ya existe: 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin Aroma\",\n  \"correo\": \"admin@aroma.gt\",\n  \"password\": \"claveSegura123\",\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {

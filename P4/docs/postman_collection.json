    {
      "name": "2. Catalogo (GraphQL, Node.js)",
      "item": [
        {
          "name": "Menu completo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/catalogo/graphql",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "catalogo",
                "graphql"
              ]
            },
            "description": "Permiso catalogo:usar. Admin y Cliente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query {\\n  categorias { id nombre descripcion }\\n  productos { id nombre precio disponible categoria { nombre } }\\n}\",\n  \"variables\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Solo lo disponible",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/catalogo/graphql",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "catalogo",
                "graphql"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($soloDisponibles: Boolean) {\\n  productos(soloDisponibles: $soloDisponibles) { id nombre precio }\\n}\",\n  \"variables\": {\n    \"soloDisponibles\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Un producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/catalogo/graphql",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "catalogo",
                "graphql"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($id: ID!) {\\n  producto(id: $id) { id nombre precio disponible categoria { nombre } }\\n}\",\n  \"variables\": {\n    \"id\": \"{{producto_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Crear producto (solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/catalogo/graphql",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "catalogo",
                "graphql"
              ]
            },
            "description": "Con una sesion Cliente el resolver responde FORBIDDEN.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($entrada: ProductoEntrada!) {\\n  crearProducto(entrada: $entrada) { id nombre precio }\\n}\",\n  \"variables\": {\n    \"entrada\": {\n      \"nombre\": \"Mocha de temporada\",\n      \"descripcion\": \"Chocolate y naranja\",\n      \"precio\": 28.0,\n      \"categoriaId\": \"1\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Agotar un producto (solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/catalogo/graphql",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "catalogo",
                "graphql"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id: ID!, $disponible: Boolean!) {\\n  cambiarDisponibilidad(id: $id, disponible: $disponible) { id nombre disponible }\\n}\",\n  \"variables\": {\n    \"id\": \"{{producto_id}}\",\n    \"disponible\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
